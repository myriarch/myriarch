# Project-wide OCI label values of the container images.
#
# Read by scripts/build-image-crane.sh, scripts/build-collector-image-crane.sh and scripts/build-mirror-image-crane.sh
# through scripts/lib/image-common.sh (image_labels_load). Per-build values (version, revision, created, base.name,
# base.digest, descriptions with versions) stay in the scripts.
#
# Format: KEY=value, one per line, '#' starts a comment line. No quotes, no shell expansion. Values must not contain
# commas (crane parses --label as CSV). The keys carry the LABEL_ prefix so they can never clobber the variables of the
# scripts (IMAGE_REPO, IMAGE_UID, ...).

# org.opencontainers.image.vendor / vendor
LABEL_VENDOR=The Myriarch Authors

# org.opencontainers.image.licenses (SPDX expression) of the images that contain only the project and its dependencies
# (the Dockerfiles of deploy/docker set the same value; internal/updater/deploy_consistency_test.go compares them).
# The collector image has no licenses label: its alpine base brings packages under many other licenses.
LABEL_LICENSES=Apache-2.0

# org.opencontainers.image.licenses of the mirror image: OpenTelemetry release files (Apache-2.0) on a busybox base (GPL-2.0-only)
LABEL_LICENSES_MIRROR=Apache-2.0 AND GPL-2.0-only

# org.opencontainers.image.source of the project: the label of the release images (scripts/build-image-crane.sh with
# IMAGE_SOURCE=dist uses SOURCE_URL or this value and never the git remote, so a release image does not depend on the
# checkout it was built in; ghcr.io links a package to this repository through the label) and the fallback of the other
# builds when neither SOURCE_URL nor the git remote (origin) yields an https URL. Empty means: the label is omitted.
LABEL_SOURCE=https://github.com/myriarch/myriarch

# org.opencontainers.image.title / name / io.k8s.display-name of the images (crane scripts); LABEL_TITLE is the server image
LABEL_TITLE=myriarch
LABEL_TITLE_UPDATER=myriarch-updater
LABEL_TITLE_COLLECTOR=myriarch collector (opampsupervisor + otelcol-contrib)
LABEL_TITLE_MIRROR=myriarch mirror (release files of the OpenTelemetry Collector)
