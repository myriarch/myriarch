OTELCOL_VERSION=0.162.0
OTELCOL_CONTRIB_IMAGE=otel/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6
OTELCOL_SUPERVISOR_IMAGE=otel/opentelemetry-collector-opampsupervisor:0.162.0@sha256:13af4526381fe8279fb78f211628fea5cae693bf413737f234ee3587d9a44fb6
