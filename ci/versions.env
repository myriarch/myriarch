# Pinned versions of the CI tooling and upstream artifacts (single source of truth).
#
# Format: NAME=VALUE, no quotes, no spaces in the value. The file is shell compatible (`. ci/versions.env`) and is read
# by the ci/*.sh scripts (ci/lib.sh load_versions). Variables already set in the environment take precedence.
#
# Updating: tools via ci/tools/update.sh <tool> (after changing the version here); image digests via ci/pin-images.sh
# (needs crane); then commit the result. ci/check.sh verifies that the pins and the Dockerfiles agree.

# ---- Tools (built from ci/tools/<tool>/ by ci/install-tools.sh) ------------------------------------
GORELEASER_VERSION=v2.18.2
COSIGN_VERSION=v3.1.3
GOTESTSUM_VERSION=v1.13.0
HELM_VERSION=v4.2.4
KUSTOMIZE_VERSION=v5.8.1
YQ_VERSION=v4.54.1
KUBECONFORM_VERSION=v0.8.0
CRANE_VERSION=v0.22.1
GOVULNCHECK_VERSION=v1.8.0
GOLICENSES_VERSION=v2.0.1
GITLEAKS_VERSION=v8.30.1
KIND_VERSION=v0.33.0
ACTIONLINT_VERSION=v1.7.12
GH_VERSION=v2.102.0
GOWINRES_VERSION=v0.3.3

# reuse (the REUSE compliance checker, https://reuse.software) is a Python tool, installed by `ci/install-tools.sh reuse`
# into a virtual environment (.cache/reuse/<version>, linked as ${TOOLS_BIN}/reuse). Constraints:
#  - Python 3.9 or newer is required (REUSE_PYTHON selects the interpreter; Debian also needs python3-venv). reuse 6.x
#    requires Python 3.10 or newer, so 5.1.1 (REUSE specification 3.3) is the last release that runs everywhere the other
#    tools run. Raise the pin only together with the Python floor of the CI images and of the supported developer systems.
#  - Every package is pinned by hash: ci/tools/reuse/requirements.txt (reuse and its runtime dependencies) and
#    ci/tools/reuse/build-requirements.txt (poetry-core, which builds reuse from its sdist because 5.1.1 publishes no
#    wheel for most platforms). pip runs with --require-hashes; pip honors PIP_INDEX_URL for an internal mirror.
#  - ci/check.sh verifies that requirements.in and requirements.txt pin reuse==${REUSE_VERSION}.
# Update: change the version here and in ci/tools/reuse/requirements.in, then regenerate both files (uv, no config file):
#   uv pip compile --no-config --python-version 3.9 --generate-hashes --no-header --no-annotate \
#     ci/tools/reuse/requirements.in -o ci/tools/reuse/requirements.txt
#   uv pip compile --no-config --python-version 3.9 --generate-hashes --no-header --no-annotate \
#     ci/tools/reuse/build-requirements.in -o ci/tools/reuse/build-requirements.txt
REUSE_VERSION=5.1.1

# shellcheck is not a Go tool, so it is a release download verified by SHA-256 (ci/install-tools.sh shellcheck).
# Update: download the four .tar.gz assets of the new release (shellcheck-<version>.{darwin,linux}.{aarch64,x86_64}.tar.gz)
# and record their SHA-256 here.
SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256_DARWIN_ARM64=339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f
SHELLCHECK_SHA256_DARWIN_AMD64=c2c15e08df0e8fbc374c335b230a7ee958c313fa5714817a59aa59f1aa594f51
SHELLCHECK_SHA256_LINUX_ARM64=68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc
SHELLCHECK_SHA256_LINUX_AMD64=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6

# PowerShell 7 only runs the installer tests (the pwsh tests in internal/updater and ci/tests/installer-verify.ps1). Like
# shellcheck it is a release download verified by SHA-256 (ci/install-tools.sh pwsh). Update: take the SHA-256 of the four
# assets powershell-<version>-{osx,linux}-{arm64,x64}.tar.gz from the release, check one by downloading it, record them here.
POWERSHELL_VERSION=7.6.6
POWERSHELL_SHA256_DARWIN_ARM64=6df833d094ebac1c1a74340d7b3437f4aaf5e03ce640484a1c4359f3ce8b3db1
POWERSHELL_SHA256_DARWIN_AMD64=e325ed9f666894eb39a5ea52800b602da2fb4242bbe9747ceddb39cdc66de805
POWERSHELL_SHA256_LINUX_ARM64=924829e54c983648f6f1419a2dc7f9433c861b2fb5bd57736ff096c24f133729
POWERSHELL_SHA256_LINUX_AMD64=ddbc4a2d113bbd46d283cfedcbcd117a70caefd7673f41f2b4e0000badf103bc

# kubectl is not a Go tool we can build (k8s.io/kubernetes/cmd/kubectl needs the replace directives of the main module),
# so it is a release download verified by SHA-256 (ci/install-tools.sh kubectl). It only drives the kind probe (hack/kind);
# its minor version must be within the supported skew (+-1) of the kind node image (KIND_NODE_IMAGE in hack/kind/versions.env).
# Update: take the four values from https://dl.k8s.io/release/<version>/bin/<os>/<arch>/kubectl.sha256 and check one of
# them by downloading the binary.
KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256_DARWIN_ARM64=fd65982c97ddad3106754b69ffa196d0e543aa591930ae52aed1adfb92f8c77f
KUBECTL_SHA256_DARWIN_AMD64=6851381c486ff6edd691623e3d65c87cb9a5b02887ff8fbbb38d8a031b748387
KUBECTL_SHA256_LINUX_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
KUBECTL_SHA256_LINUX_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8

# The documentation website (website/, ADR-0031) is built with Hugo extended (a single Go binary) and Dart Sass (Docsy compiles its
# SCSS with it), and checked with lychee (links). All three are release downloads verified by SHA-256 (ci/install-tools.sh hugo sass
# lychee); the environment cannot override a pin.
#
# Hugo: take the values from hugo_<version>_checksums.txt of the release (assets hugo_extended_<version>_linux-amd64.tar.gz,
# hugo_extended_<version>_linux-arm64.tar.gz and hugo_extended_<version>_darwin-universal.pkg, which macOS ships instead of an
# archive) and check one of them by downloading the asset.
HUGO_VERSION=0.167.0
HUGO_SHA256_DARWIN_UNIVERSAL=151803e873d8c47d54339a7c1ed57cf1ac9ea08831c8378b33dd2616f9ced885
HUGO_SHA256_LINUX_AMD64=0163f5c3deddac1f494a1629ddc40c65d18de9d5794facd98f7f96ac2c7d8957
HUGO_SHA256_LINUX_ARM64=c73eaba13738754b50de4d07606670d5c0cd2eaaf2057af657cec9efd3b01876

# Dart Sass: the releases carry no checksum file; take the SHA-256 digest that GitHub shows for the assets
# dart-sass-<version>-{macos,linux}-{arm64,x64}.tar.gz (API field "digest") and check one of them by downloading the asset.
DART_SASS_VERSION=1.105.1
DART_SASS_SHA256_DARWIN_ARM64=4453e66a326f350821622912d99115eefe6a636838a10a279e341254ef00594d
DART_SASS_SHA256_DARWIN_AMD64=f40e107223cebaaf3dbd6c6ed5849dbb791efd008f80a58df2746e5fa54cf1eb
DART_SASS_SHA256_LINUX_ARM64=7f53a2a77ef4aaf24a9f2f8c826759ed93b38954430a2e32130921a2e16a4a1c
DART_SASS_SHA256_LINUX_AMD64=9046fdd4a31a524a0020298c55d9e155d4c22363ef268e8992574335a72c6a6f

# lychee: take the values from the .sha256 assets of the release (lychee-<target>.tar.gz.sha256 for aarch64-apple-darwin,
# x86_64-apple-darwin, aarch64-unknown-linux-musl and x86_64-unknown-linux-musl) and check one of them by downloading the asset.
LYCHEE_VERSION=0.24.2
LYCHEE_SHA256_DARWIN_ARM64=c9d3740ea2d891854d37116c9fba840f37b6e7c89d330e7db84ac333631c4977
LYCHEE_SHA256_DARWIN_AMD64=887503a9cff667d322b8d0892b40bf49976eb9507af8483220a3706cdad55978
LYCHEE_SHA256_LINUX_ARM64=5d0b0e3aeab240f41920c633a6eaf97599be6eedda034b36e858ede7dba5e535
LYCHEE_SHA256_LINUX_AMD64=73657a111819a30c47c08352896796f23d64e4eb2b3ed39b6d32149241566fc5

# syft (SBOM generation) is a release download verified by SHA-256 (ci/install-tools.sh syft), not a Go build from ci/tools: the
# upstream release binaries carry their version (a build with `go build` reports "[not provided]" and the SBOMs name no tool
# version), and a Go module for syft would bring its whole dependency graph into the repository. The release publishes
# syft_<version>_{darwin,linux}_{arm64,amd64}.tar.gz. Update: take the SHA-256 digest that GitHub shows for these assets (API
# field "digest" of `gh api repos/anchore/syft/releases/tags/v<version>`; syft_<version>_checksums.txt lists the same values)
# and check one of them by downloading the asset. The version has no "v" prefix.
SYFT_VERSION=1.54.1
SYFT_SHA256_DARWIN_ARM64=b4319c3abaa87a0170ab76ee83ea2260ca34b53aecfa3ab0dd5428d2319d744f
SYFT_SHA256_DARWIN_AMD64=2956322838b2f64e470eea474495f0cd96be4f222b1ac037258cdc47d965064e
SYFT_SHA256_LINUX_ARM64=dfdf0537610113edbefe1f1fc6548bc957b2d77439636ec824fcf0e10d46d054
SYFT_SHA256_LINUX_AMD64=c069905b391cc4c20a5ba65ad5c10be2a7ba074f8ea6ad203e24d14e303dad47

# zizmor (the static analyser of GitHub Actions workflows) is a release download verified by SHA-256 (ci/install-tools.sh zizmor).
# The release publishes binaries for macOS and for Linux (glibc, "gnu" targets; there is no musl build). Update: take the SHA-256
# digest that GitHub shows for the assets zizmor-{aarch64,x86_64}-{apple-darwin,unknown-linux-gnu}.tar.gz (API field "digest" of
# `gh api repos/zizmorcore/zizmor/releases/tags/v<version>`) and check one of them by downloading the asset.
ZIZMOR_VERSION=1.30.1
ZIZMOR_SHA256_DARWIN_ARM64=e28d22b087f9ebb8d99da6e740d348c930f559961c7c3f12badda54f882195a2
ZIZMOR_SHA256_DARWIN_AMD64=10e6b18b11ea07e515a16f0f0518c7b07527bc9977c1fd5698181ce7f3554202
ZIZMOR_SHA256_LINUX_ARM64=7ff1dce33bdd18fd2a4affe63bdd47efcccca97b2cec1c1863ec26e9e2647540
ZIZMOR_SHA256_LINUX_AMD64=e65324f4430c2717591937edcec90ccbefaf14c174f8ec9415e03ca875b46e1a

# osslsigncode signs and verifies the Authenticode signatures of the Windows release files (ci/release/authenticode.py).
# It is a C program with no Go module, and upstream publishes no Linux binary. ci/install-tools.sh builds it from the source
# archive of the tag, verified against OSSLSIGNCODE_SOURCE_SHA256; the environment cannot override the pin.
# Build prerequisites: a C compiler, the OpenSSL 3 headers and zlib (Debian/Ubuntu: libssl-dev zlib1g-dev; macOS: the Xcode
# command line tools and Homebrew openssl@3, or OSSLSIGNCODE_OPENSSL_PREFIX).
# Never use a distribution package: Ubuntu 24.04 ships 2.8, which predates the verification fixes of 2.12 and 2.13.
# Update: change the version, download https://github.com/mtrojnar/osslsigncode/archive/refs/tags/<version>.tar.gz twice, and
# record its SHA-256.
OSSLSIGNCODE_VERSION=2.14
OSSLSIGNCODE_SOURCE_SHA256=0f033fd6069387d2e489fbd2187e62f624764eb8c2758ee94e3e793e5150b5c5

# ---- Upstream collector (image deploy/k8s/collector/Dockerfile) --------------------------------------
