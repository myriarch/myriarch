# The frozen signing identity of the Myriarch releases (ADR-0029, ADR-0035). The scripts in ci/release read this file as data
# (KEY=value, no shell evaluation, no override from the environment). ci/tests/release-scripts-test.sh pins the values to
# internal/brand, ADR-0029, the installers, ci/image-labels.env and ci/release/push-images.sh.
#
# Changing a value breaks the verification of every installed updater and every installer: the identity
# https://github.com/<RELEASE_REPOSITORY>/<RELEASE_WORKFLOW>@refs/tags/v<version> is what they accept. A change needs a new ADR with a
# transition for every installed verifier.
RELEASE_REPOSITORY=myriarch/myriarch
RELEASE_WORKFLOW=.github/workflows/release.yml
RELEASE_OIDC_ISSUER=https://token.actions.githubusercontent.com
RELEASE_TRIGGER=push
RELEASE_IMAGE_SERVER=ghcr.io/myriarch/myriarch
RELEASE_IMAGE_UPDATER=ghcr.io/myriarch/myriarch-updater
RELEASE_CHART=ghcr.io/myriarch/charts/myriarch
