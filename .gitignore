# Go
/bin/
/dist/
*.test
*.out
coverage.*

# CI (ci/): caches, reports and intermediate results of the CI scripts
/.cache/
/ci-out/
/reports/

# myriarchd dev mode (embedded PostgreSQL data, clones, artifacts)
/.dev/
/.e2e/

# UI
/web/node_modules/
/web/coverage/
/internal/webui/dist/
/web/dist-mock/

# Website (website/): build output, Hugo's generated resources, dependencies
/website/node_modules/
/website/public/
/website/data/source_dates.json
/website/resources/
/website/.hugo_build.lock

# Editors / OS
.idea/
.vscode/
.DS_Store

# binaries from `go build ./cmd/<name>` in the repo root
/myriarchd
/myrctl
/myriarch-updater
/myriarch-sim

# Claude Code: private session rules and local state (never committed)
CLAUDE.local.md
/.claude/

# Python bytecode of the helper scripts
__pycache__/
*.pyc

# Website: state of the Vercel CLI and the output assembled for a deployment (.github/workflows/website.yml)
/.vercel/

# Windows version resources that the release build generates (deploy/release/windows-signed.sh prepare); never committed,
# and ignored so that Go stamps vcs.modified=false and two builds stay identical
/cmd/myriarch-updater/rsrc_windows_*.syso
/cmd/myrctl/rsrc_windows_*.syso
