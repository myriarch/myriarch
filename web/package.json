{
  "name": "myriarch-web",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "description": "myriarch web UI (React + TypeScript + Vite)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "VITE_MOCK=1 tsc -b && VITE_MOCK=1 vite build --mode mock --outDir dist-mock --emptyOutDir",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../api/openapi.yaml --default-non-nullable false -o src/api/schema.d.ts && node scripts/add-license-header.mjs src/api/schema.d.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@mantine/charts": "^9.7.0",
    "@mantine/core": "^9.7.0",
    "@mantine/dates": "^9.7.0",
    "@mantine/form": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.1",
    "@uiw/react-codemirror": "^4.25.12",
    "dayjs": "^1.11.23",
    "i18next": "^25.10.10",
    "openapi-fetch": "~0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^16.6.6",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
