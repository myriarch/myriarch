{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `make docs-gen` from testdata/chartschema/source.yaml and the mini configuration. Do not edit this file by hand: change the source or the configuration structure and run `make docs-gen`.",
  "title": "Mini chart values",
  "description": "The values of a mini chart.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "description": "Number of replicas.",
      "type": "integer",
      "minimum": 1
    },
    "ratio": {
      "description": "A number with a fraction, a boolean default and a null.",
      "type": "number",
      "minimum": 0.5,
      "default": null,
      "deprecated": false
    },
    "mode": {
      "description": "A short enumeration stays on one line.",
      "enum": ["fast", "slow"]
    },
    "service": {
      "description": "A long enumeration is wrapped.",
      "enum": [
        "ClusterIP",
        "NodePort",
        "LoadBalancer",
        "ExternalName",
        "Headless",
        "SomethingWithALongName"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "$ref": "#/$defs/host"
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z]*$"
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "description": "The mini configuration, rendered into the file of the mini server. The chart does not offer these keys: server.password (a secret), server.tls.secrets.<name>.env (the environment is not offered), notify.channels[].url (a secret), dev (the development mode does not exist).",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "object",
          "description": "`server` configures the listener of the <mini> server (HTTP | HTTPS), see docs/operations/authentication.md and docs/reference/gitops-schema.md.",
          "additionalProperties": false,
          "properties": {
            "listenAddr": {
              "type": "string",
              "description": "`listenAddr` is the address of the listener, as host:port (default \":8080\"). The value *must* not use a [scheme] and the setting_name is escaped."
            },
            "tls": {
              "type": "object",
              "description": "`tls` configures the certificate. See `server.tls.certFile`.",
              "additionalProperties": false,
              "properties": {
                "certFile": {
                  "type": "string",
                  "description": "`certFile` is the certificate file."
                },
                "secrets": {
                  "type": "object",
                  "description": "`secrets` are named secrets with their allowed hosts.",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "allowedHosts": {
                        "type": "array",
                        "description": "`allowedHosts` lists the destinations.",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "timeout": {
              "type": "string",
              "description": "`timeout` limits one request. A second line of the comment joins the first.",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|ms|s|m|h))+)$"
            },
            "grace": {
              "type": "string",
              "description": "`grace` is a duration without trailing zero units.",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|ms|s|m|h))+)$"
            },
            "maxBodyBytes": {
              "type": "integer",
              "description": "`maxBodyBytes` limits the body of a request."
            },
            "cacheSize": {
              "type": "integer",
              "description": "`cacheSize` is a size that is not a multiple of 1024."
            },
            "workers": {
              "type": "integer",
              "description": "`workers` is the number of workers; the development default differs."
            },
            "ratio": {
              "type": "number",
              "description": "`ratio` is a floating point number."
            },
            "hosts": {
              "type": "array",
              "description": "`hosts` lists the allowed hosts as `*.example.com` or \"a|b\".",
              "items": {
                "type": "string"
              }
            },
            "labels": {
              "type": "object",
              "description": "`labels` is a map of strings.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "routes": {
              "type": "object",
              "description": "`routes` maps names to lists of hosts.",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "mode": {
              "type": "string",
              "description": "`mode` selects the mode."
            },
            "backup": {
              "type": "object",
              "description": "`backup` is the backup of the mini server; a field of this type relies on this comment.",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "`enabled` switches the backup on."
                }
              }
            },
            "quiet": {
              "type": "boolean",
              "description": "`quiet` switches the output off."
            },
            "verbose": {
              "type": "boolean",
              "description": "`verbose` adds detail to the output (documented on the line of the field)."
            }
          }
        },
        "notify": {
          "type": "object",
          "description": "`notify` configures the notifications.",
          "additionalProperties": false,
          "properties": {
            "channels": {
              "type": "array",
              "description": "`channels` lists the channels.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "`name` identifies the channel."
                  }
                }
              }
            }
          }
        },
        "shapes": {
          "type": "object",
          "description": "`shapes` holds the field types that MiniConfig does not have.",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "description": "`port` is an unsigned port number.",
              "minimum": 0
            },
            "retries": {
              "type": "integer",
              "description": "`retries` is a signed number that may be negative."
            },
            "names": {
              "type": "array",
              "description": "`names` is a list of strings.",
              "items": {
                "type": "string"
              }
            },
            "budget": {
              "type": "string",
              "description": "`budget` is a duration; the loader accepts only Go syntax.",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|ms|s|m|h))+)$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "host": {
      "description": "A host name with <angle brackets> & an ampersand.",
      "type": "string"
    }
  }
}
