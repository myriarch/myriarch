# Default excludes of scripts/check-language.sh: one git glob per line (`**` works), `#` starts a comment.
# Every entry stays here only as long as its reason holds.

# German UI catalog: the German language of the catalog is the point of the file.
web/src/i18n/de.json

# German demo data of the web UI counts as a fixture (mocks).
web/src/mocks/**

# Test fixtures and golden files carry German samples on purpose.
**/testdata/**
**/*.golden
**/__fixtures__/**
**/fixtures/**

# The guard's own word list and its test fixtures contain German words on purpose.
scripts/check-language.sh
scripts/check-language.exclude
ci/tests/check-language-test.sh

# Verbatim third-party license texts and NOTICE files (generated by scripts/gen-third-party-notices.sh) contain names
# and words in other languages that must not be altered.
THIRD_PARTY_NOTICES
