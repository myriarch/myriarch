# Authenticode signing of the Windows release files (myriarch-updater.exe and myrctl.exe): the mode and the one reviewed
# exception. The release tag guard (ci/release/guard.sh) reads this file before anything is built or signed and refuses a
# tag that breaks the rule below.
# The file is data, not shell: only the two lines "KEY=value" are allowed, with no quotes and no spaces, and every other
# non-comment line fails the guard.
#
# WINDOWS_SIGNING selects how the Windows files are signed:
#   off        the files are not signed. Allowed for rc tags (vX.Y.Z-rc.N). A final tag (vX.Y.Z) passes only under the
#              exception below.
#   signpath   signing through SignPath (certificate and key stay with the provider).
#   kms        signing with a certificate whose key is in a cloud HSM (Google Cloud KMS).
#   Any other value fails the guard (fail closed).
WINDOWS_SIGNING=off

# WINDOWS_UNSIGNED_FINAL_TAG is the exception: exactly one final tag that may be released with WINDOWS_SIGNING=off, for
# example v0.1.0. Empty means no exception, so every final tag then needs WINDOWS_SIGNING=signpath or kms. The guard compares
# the value with the pushed tag character by character; a different final tag, an rc tag or a pattern does not match. The
# release notes of such a tag show an "unsigned" banner. Set it only in the reviewed pull request that prepares that release
# and clear it again afterwards (ADR-0034 records the exception).
WINDOWS_UNSIGNED_FINAL_TAG=v0.1.0
