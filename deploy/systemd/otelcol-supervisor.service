[Unit]
Description=OpenTelemetry Collector (OpAMP supervisor, managed by myriarch)
Documentation=https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/cmd/opampsupervisor
After=network-online.target
Wants=network-online.target
AssertPathExists=/etc/myriarch/supervisor.yaml

[Service]
Type=simple
User=otelcol
Group=otelcol
# MYRIARCH_ENROLLMENT_TOKEN and collector secrets (for example OTEL_GATEWAY_TOKEN); 0600 root:root
EnvironmentFile=/etc/myriarch/myriarch.env
ExecStart=/opt/myriarch/supervisor/opampsupervisor --config /etc/myriarch/supervisor.yaml
Restart=always
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
# /var/lib/otelcol (supervisor storage, collector queue), owned by otelcol
StateDirectory=otelcol
StateDirectoryMode=0750
WorkingDirectory=/var/lib/otelcol
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# The collector runs configuration from Git with the rights of this account: no capabilities, no kernel
# or clock access, no new namespaces. ProtectSystem stays "full" (file exporters write below /var).
# A receiver that needs more (a port below 1024, the hardware or the audit log) gets a drop-in, for example
#   [Service]
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0027
# journald receiver/log files: add groups if needed, for example
# SupplementaryGroups=systemd-journal adm

[Install]
WantedBy=multi-user.target
