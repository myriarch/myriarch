# Pins of the kind probe (hack/kind). Format: NAME=VALUE, no quotes, no spaces; shell compatible. Every *_IMAGE is pinned
# by the digest of the multi-platform index (linux/amd64 and linux/arm64), so the probe runs the same bytes on Apple
# Silicon and on x86 CI runners. ci/check.sh verifies the pins. Update: `crane digest <image:tag>`, then run the probe.
# The kubectl pin is in ci/versions.env (KUBECTL_VERSION); its minor version must be within the skew of KIND_NODE_IMAGE.

# kind node image (Kubernetes v1.37.0). The default of kind v0.33.0; override KIND_NODE_IMAGE to test another version.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# The previous Kubernetes minor version (v1.36.4), the second entry of the matrix of the chart installation test (ci/kind-chart-test.sh,
# .github/workflows/e2e-kind.yml). It stays within the skew of the kubectl pin (+/- one minor version); the charts need Kubernetes 1.30
# or later (kubeVersion). Update both node images together when kind or kubectl moves on.
KIND_NODE_IMAGE_PREVIOUS=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
# The release image of the chart that the upgrade step of the chart installation test installs first (tag v0.1.0), by digest of the index.
UPGRADE_FROM_SERVER_IMAGE=ghcr.io/myriarch/myriarch:0.1.0@sha256:6de6a32fc7be2dd583f6e60c08cb0bba2aebdd2fcb264b89c44196683ee8d963
# Local registry that serves the freshly built images to the nodes (localhost:5001 on the host).
REGISTRY_IMAGE=registry:3@sha256:ddf754342cfc8acc51a56d5d0ab6af06826461864460636d8bd5c546dab2a7b8
# PostgreSQL (the same digest as deploy/compose/docker-compose.yaml).
POSTGRES_IMAGE=postgres:17@sha256:ae69c452f483507a6b99fb654cf93aad7fe156ffd2c56247707eef4e36d3c12b
# In-cluster Git server for the GitOps source (alpine + git + openssh, installed at start). The packages are pinned to the
# upstream series with apk's "~" match (git~2.49 accepts 2.49.x-rN): reproducible for the upstream version, robust against
# Alpine revision bumps (Alpine removes old -rN builds from the mirror). The installed versions are printed in the pod log.
GIT_SERVER_IMAGE=alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
GIT_SERVER_GIT_SERIES=2.49
GIT_SERVER_OPENSSH_SERIES=10.0
# Test client and file server of the NetworkPolicy self-test and the DNS check.
BUSYBOX_IMAGE=busybox:1.37@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
CURL_IMAGE=curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
# The collector of the real agent: image version (the update goes to the version in ci/versions.env, OTELCOL_VERSION).
OTELCOL_PREV_VERSION=0.161.0
OTELCOL_PREV_CONTRIB_IMAGE=otel/opentelemetry-collector-contrib:0.161.0@sha256:fd328de2552466ad78385e1b1289c3f2402b1c45f265b252aab1955b42845ac1
OTELCOL_PREV_SUPERVISOR_IMAGE=otel/opentelemetry-collector-opampsupervisor:0.161.0@sha256:ffec7484b8f76e540aa943e7210b9d5ebbf714a38b1f2e4f8568839e9f929d2f
# Dex (demo identity provider of the OIDC stage): upstream chart, verified by the SHA-256 of the pulled archive.
DEX_CHART_VERSION=0.26.0
DEX_CHART_SHA256=3b22c1447935221a040870508274bff85a68b2b841902097d6fcacb3e9badd03
DEX_IMAGE=ghcr.io/dexidp/dex:v2.46.0@sha256:933fcd3f523338c847b88ef84a7145fb2fcb7b9917f08418612afeaaa2001777
